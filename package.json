{
  "name": "era",
  "version": "3.0.9",
  "description": "Project Era OGFN",
  "author": "ERA",
  "main": "app/index.js",
  "desktopName": "era-code-appimage",
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "@sentry/electron": "^7.2.0",
    "@sentry/esbuild-plugin": "^4.6.0",
    "@sentry/react": "^10.24.0",
    "@tanstack/react-query": "^5.90.6",
    "@xhayper/discord-rpc": "^1.3.0",
    "axios": "^1.13.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.3.0",
    "electron-serve": "^2.1.1",
    "electron-updater": "^6.3.9",
    "electronmon": "^2.0.3",
    "html2canvas": "^1.4.1",
    "meshline": "^3.3.1",
    "motion": "^12.23.24",
    "node-abi": "^4.17.0",
    "phoenix": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.181.0",
    "undici": "^7.16.0",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start:linux": "bash ./run-linux.sh",
    "install:linux-desktop": "bash ./install-linux-desktop.sh",
    "install:appimage-desktop": "bash ./install-era-appimage-integration.sh",
    "start:mac": "bash ./run-mac.sh",
    "dist:appimage": "electron-builder --linux AppImage --x64",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:arm64": "electron-builder --mac zip --arm64",
    "dist:mac:x64": "electron-builder --mac zip --x64",
    "dist:mac:universal": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "39.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.erafn.era",
    "productName": "Era Code",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "!app/workers/**",
      "!app/binaries/**",
      "!app/build/**",
      "!app/**/*.obj",
      "!app/**/*.iobj",
      "!app/**/*.ipdb",
      "!app/**/*.recipe",
      "!app/**/*.tlog/**",
      "!app/**/*.vcxproj",
      "!app/**/*.vcxproj.filters",
      "!app/**/*.pdb",
      "!app/**/*.bak*",
      "!app/**/*.backup*"
    ],
    "extraResources": [
      {
        "from": "app/workers",
        "to": "workers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/binaries",
        "to": "binaries",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Era-Code-${version}-${arch}.${ext}",
      "icon": "app/renderer/icon.icns",
      "protocols": [
        {
          "name": "Era Code authentication link",
          "schemes": [
            "fluxapp"
          ]
        }
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "era-code",
      "artifactName": "Era-Code-${version}-${arch}.${ext}",
      "synopsis": "Era Code launcher",
      "description": "Era Code launcher for Linux",
      "mimeTypes": [
        "x-scheme-handler/fluxapp"
      ],
      "protocols": [
        {
          "name": "Era Code authentication link",
          "schemes": [
            "fluxapp"
          ]
        }
      ],
      "icon": "app/renderer/icon.png"
    }
  },
  "allowScripts": {
    "electron@39.1.1": true
  }
}
